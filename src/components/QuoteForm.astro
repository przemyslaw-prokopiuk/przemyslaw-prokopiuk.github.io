---
// Quote configurator: gathers order parameters and opens the visitor's email
// client with a structured message (no backend needed — static site).
interface Props {
  labels: {
    eyebrow: string;
    title: string;
    intro: string;
    service: string;
    services: string[];
    size: string;
    sizePlaceholder: string;
    material: string;
    materialPlaceholder: string;
    quantity: string;
    quantityPlaceholder: string;
    deadline: string;
    deadlinePlaceholder: string;
    notes: string;
    notesPlaceholder: string;
    submit: string;
    gmail: string;
    copy: string;
    copied: string;
    hint: string;
    subject: string;
    intro2: string;
    attachNote: string;
  };
}

const { labels: l } = Astro.props;
const inputCls = "w-full rounded-xl border border-navy-200 px-4 py-3 text-sm text-navy-950 focus:border-accent-500 focus:outline-2 focus:outline-accent-500/40";
const labelCls = "block font-bold text-sm text-navy-900 mb-2";
---

<div class="bg-white rounded-2xl border border-navy-100 shadow-sm p-7 md:p-10 mb-16">
  <div class="text-center mb-8">
    <p class="eyebrow text-accent-600 mb-3">{l.eyebrow}</p>
    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3">{l.title}</h2>
    <p class="text-gray-600 max-w-xl mx-auto">{l.intro}</p>
  </div>

  <form id="quote-form" class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto"
    data-subject={l.subject} data-intro={l.intro2} data-attach={l.attachNote}
    data-f-service={l.service} data-f-size={l.size} data-f-material={l.material}
    data-f-quantity={l.quantity} data-f-deadline={l.deadline} data-f-notes={l.notes}>

    <div>
      <label for="q-service" class={labelCls}>{l.service}</label>
      <select id="q-service" class={inputCls}>
        {l.services.map(s => <option>{s}</option>)}
      </select>
    </div>

    <div>
      <label for="q-material" class={labelCls}>{l.material}</label>
      <input id="q-material" type="text" placeholder={l.materialPlaceholder} class={inputCls} />
    </div>

    <div>
      <label for="q-size" class={labelCls}>{l.size}</label>
      <input id="q-size" type="text" placeholder={l.sizePlaceholder} class={inputCls} />
    </div>

    <div>
      <label for="q-quantity" class={labelCls}>{l.quantity}</label>
      <input id="q-quantity" type="text" placeholder={l.quantityPlaceholder} class={inputCls} />
    </div>

    <div class="sm:col-span-2">
      <label for="q-deadline" class={labelCls}>{l.deadline}</label>
      <input id="q-deadline" type="text" placeholder={l.deadlinePlaceholder} class={inputCls} />
    </div>

    <div class="sm:col-span-2">
      <label for="q-notes" class={labelCls}>{l.notes}</label>
      <textarea id="q-notes" rows="4" placeholder={l.notesPlaceholder} class={inputCls}></textarea>
    </div>

    <div class="sm:col-span-2 text-center">
      <button type="submit" class="btn btn-primary w-full sm:w-auto">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        {l.submit}
      </button>
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 mt-4 text-sm">
        <button type="button" id="q-gmail" class="font-bold text-navy-700 hover:text-accent-600 transition-colors">{l.gmail}</button>
        <span class="text-navy-200" aria-hidden="true">·</span>
        <button type="button" id="q-copy" data-copied={l.copied} class="font-bold text-navy-700 hover:text-accent-600 transition-colors">{l.copy}</button>
      </div>
      <p class="mt-4 text-xs text-gray-500 whitespace-pre-line">{l.hint}</p>
    </div>
  </form>
</div>

<script>
  const qForm = document.getElementById('quote-form');
  if (qForm) {
    const EMAIL = 'wippdrukarnia@gmail.com';
    const d = (qForm as HTMLElement).dataset;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement).value.trim();

    const buildBody = () => [
      d.intro,
      '',
      `${d.fService}: ${val('q-service')}`,
      `${d.fMaterial}: ${val('q-material') || '—'}`,
      `${d.fSize}: ${val('q-size') || '—'}`,
      `${d.fQuantity}: ${val('q-quantity') || '—'}`,
      `${d.fDeadline}: ${val('q-deadline') || '—'}`,
      '',
      `${d.fNotes}:`,
      val('q-notes') || '—',
      '',
      d.attach,
    ].join('\n');

    qForm.addEventListener('submit', (e) => {
      e.preventDefault();
      // A programmatic anchor click fires the mail handler reliably on repeat
      // uses, unlike assigning the same mailto: URL to location twice.
      const a = document.createElement('a');
      a.href = `mailto:${EMAIL}?subject=${encodeURIComponent(d.subject || '')}&body=${encodeURIComponent(buildBody())}`;
      document.body.appendChild(a);
      a.click();
      a.remove();
    });

    document.getElementById('q-gmail')?.addEventListener('click', () => {
      const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${EMAIL}&su=${encodeURIComponent(d.subject || '')}&body=${encodeURIComponent(buildBody())}`;
      window.open(url, '_blank', 'noopener');
    });

    const copyBtn = document.getElementById('q-copy');
    copyBtn?.addEventListener('click', async () => {
      const text = `To: ${EMAIL}\n${d.subject}\n\n${buildBody()}`;
      try {
        await navigator.clipboard.writeText(text);
        const original = copyBtn.textContent;
        copyBtn.textContent = copyBtn.dataset.copied || original;
        setTimeout(() => { copyBtn.textContent = original; }, 2000);
      } catch { /* clipboard unavailable (e.g. http) — button just does nothing */ }
    });
  }
</script>
