---
import DataMatrix from './DataMatrix.astro';

interface Props {
  title: string;
  text: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { title, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-5xl mx-auto px-4">
    <div class="relative overflow-hidden bg-navy-950 rounded-3xl px-6 py-14 md:p-16 text-center text-white">
      <div class="absolute inset-0 bg-grid-dark" aria-hidden="true"></div>
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-accent-500/15 rounded-full blur-3xl" aria-hidden="true"></div>
      <DataMatrix seed={11} class="absolute -right-10 -bottom-12 w-56 text-white/[0.06] rotate-12" />

      <div class="relative">
        <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-4">{title}</h2>
        <p class="text-navy-200 mb-9 max-w-2xl mx-auto text-lg leading-relaxed">{text}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={primaryHref} class="btn btn-light">{primaryLabel}</a>
          {secondaryHref && <a href={secondaryHref} class="btn btn-outline-light">{secondaryLabel}</a>}
        </div>
      </div>
    </div>
  </div>
</section>
