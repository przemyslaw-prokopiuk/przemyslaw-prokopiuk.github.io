---
// Client-side barcode generator (QR default — readable by every phone camera;
// Data Matrix needs a 2D scanner app, which the note below the form explains).
// bwip-js is lazy-loaded on first generate so it doesn't weigh down page load.
interface Props {
  labels: {
    eyebrow: string;
    title: string;
    intro: string;
    disclaimer: string;
    typeLabel: string;
    types: { qr: string; dm: string; gs1: string; ean: string; c128: string };
    textLabel: string;
    placeholder: string;
    generate: string;
    download: string;
    note: string;
    previewHint: string;
    errInvalid: string;
    errEan: string;
  };
}

const { labels: l } = Astro.props;
---

<section id="generator" class="py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-10">
      <p class="eyebrow text-accent-600 mb-3">{l.eyebrow}</p>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3">{l.title}</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">{l.intro}</p>
    </div>

    <div class="max-w-3xl mx-auto mb-10 flex flex-col items-center gap-2 rounded-xl border border-amber-300/70 bg-amber-50 px-5 py-4 text-sm text-amber-900 leading-relaxed text-center">
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <p>{l.disclaimer}</p>
    </div>

    <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-6 items-start">
      <!-- Controls -->
      <form id="gen-form" class="bg-white rounded-2xl border border-navy-100 p-7 shadow-sm" data-err-invalid={l.errInvalid} data-err-ean={l.errEan}>
        <fieldset class="mb-5">
          <legend class="font-bold text-sm text-navy-900 mb-3">{l.typeLabel}</legend>
          <div class="flex flex-wrap gap-1.5">
            {[
              { value: 'qrcode', label: l.types.qr, checked: true, example: 'https://wipp-drukarnia.pl' },
              { value: 'datamatrix', label: l.types.dm, checked: false, example: 'https://wipp-drukarnia.pl' },
              { value: 'gs1datamatrix', label: l.types.gs1, checked: false, example: '(01)05901234123457(21)WIPP12345' },
              { value: 'ean13', label: l.types.ean, checked: false, example: '5901234123457' },
              { value: 'code128', label: l.types.c128, checked: false, example: 'WIPP-2026-001' },
            ].map(t => (
              <label class="cursor-pointer">
                <input type="radio" name="gen-type" value={t.value} checked={t.checked} data-example={t.example} class="peer sr-only" />
                <span class="inline-block whitespace-nowrap rounded-lg border border-navy-200 px-2.5 py-1.5 text-[13px] font-semibold text-gray-600 transition-colors peer-checked:bg-navy-900 peer-checked:text-white peer-checked:border-navy-900 peer-focus-visible:outline-2 peer-focus-visible:outline-accent-500">{t.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label for="gen-text" class="block font-bold text-sm text-navy-900 mb-2">{l.textLabel}</label>
        <input
          id="gen-text"
          type="text"
          placeholder={l.placeholder}
          value="https://wipp-drukarnia.pl"
          maxlength="500"
          class="w-full rounded-xl border border-navy-200 px-4 py-3 font-mono text-sm text-navy-950 focus:border-accent-500 focus:outline-2 focus:outline-accent-500/40 mb-2"
        />
        <p id="gen-error" class="hidden text-sm font-semibold text-red-600 mb-2"></p>

        <div class="flex flex-wrap gap-3 mt-4">
          <button type="submit" class="btn btn-primary text-sm">{l.generate}</button>
          <a id="gen-download" download="kod-wipp.png" class="btn btn-outline text-sm hidden">{l.download}</a>
        </div>

        <p class="mt-5 text-xs text-gray-500 leading-relaxed">{l.note}</p>
      </form>

      <!-- Preview -->
      <div class="bg-navy-950 rounded-2xl p-8 flex items-center justify-center min-h-72 relative overflow-hidden">
        <div class="absolute inset-0 bg-grid-dark" aria-hidden="true"></div>
        <div class="relative bg-white rounded-xl p-5 shadow-2xl shadow-black/40 max-w-full">
          <span id="gen-placeholder" class="block px-8 py-12 font-mono text-xs text-navy-400 text-center">{l.previewHint}</span>
          <canvas id="gen-canvas" class="hidden max-w-full h-auto [image-rendering:pixelated]" width="1" height="1"></canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('gen-form');
  if (form) {
    const textInput = document.getElementById('gen-text') as HTMLInputElement;
    const canvas = document.getElementById('gen-canvas') as HTMLCanvasElement;
    const errEl = document.getElementById('gen-error')!;
    const downloadEl = document.getElementById('gen-download') as HTMLAnchorElement;
    let bwip: any = null;
    let edited = false;

    const render = async () => {
      const bcid = (form.querySelector('input[name="gen-type"]:checked') as HTMLInputElement).value;
      const text = textInput.value.trim();
      errEl.classList.add('hidden');
      if (!text) return;

      try {
        if (!bwip) bwip = (await import('bwip-js')).default;
        const opts: any = {
          bcid,
          text,
          scale: 8,
          paddingwidth: 6,
          paddingheight: 6,
          backgroundcolor: 'FFFFFF',
        };
        if (bcid === 'ean13' || bcid === 'code128') {
          opts.height = 16;
          opts.includetext = true;
          opts.textxalign = 'center';
        }
        bwip.toCanvas(canvas, opts);
        canvas.classList.remove('hidden');
        document.getElementById('gen-placeholder')?.classList.add('hidden');
        downloadEl.href = canvas.toDataURL('image/png');
        downloadEl.download = `kod-${bcid}-wipp.png`;
        downloadEl.classList.remove('hidden');
      } catch {
        const isEan = bcid === 'ean13';
        errEl.textContent = form.dataset[isEan ? 'errEan' : 'errInvalid'] || 'Error';
        errEl.classList.remove('hidden');
        downloadEl.classList.add('hidden');
      }
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); render(); });
    form.querySelectorAll('input[name="gen-type"]').forEach(r =>
      r.addEventListener('change', () => {
        errEl.classList.add('hidden');
        if (!edited) {
          textInput.value = (r as HTMLInputElement).dataset.example || textInput.value;
          render();
        } else if (!canvas.classList.contains('hidden')) {
          render();
        }
      })
    );
    textInput.addEventListener('input', () => { edited = true; errEl.classList.add('hidden'); });
  }
</script>
