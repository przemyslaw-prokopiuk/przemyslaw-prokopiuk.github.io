---
// Sticky bottom action bar, phones/tablets only (desktop has the header CTA).
interface Props {
  lang?: string;
}

const { lang = 'pl' } = Astro.props;
const prefix = lang === 'pl' ? '' : `/${lang}`;

const t: Record<string, { call: string; quote: string }> = {
  pl: { call: 'Zadzwoń', quote: 'Zamów wycenę' },
  en: { call: 'Call us', quote: 'Get a quote' },
  ru: { call: 'Позвонить', quote: 'Заказать расчёт' },
};

const l = t[lang] || t.pl;
---

<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-navy-100 px-3 py-2.5 flex gap-2.5 [padding-bottom:max(0.625rem,env(safe-area-inset-bottom))]">
  <a href="tel:+48604286423" class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-navy-900 text-white text-sm font-bold py-3 hover:bg-navy-800 transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
    {l.call}
  </a>
  <a href={`${prefix}/kontakt/`} class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl border-2 border-navy-900 text-navy-900 text-sm font-bold py-3 hover:bg-navy-50 transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
    {l.quote}
  </a>
</div>
