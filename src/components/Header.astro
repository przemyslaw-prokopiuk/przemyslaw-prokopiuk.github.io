---
interface Props {
  lang?: string;
}

const { lang = 'pl' } = Astro.props;
const pathname = Astro.url.pathname;
const current = pathname.endsWith('/') ? pathname : `${pathname}/`;

const navLabels: Record<string, Record<string, string>> = {
  pl: { home: 'Strona Główna', dataMatrix: 'Data Matrix', barcodes: 'Kody kreskowe', services: 'Usługi', portfolio: 'Realizacje', contact: 'Kontakt' },
  en: { home: 'Home', dataMatrix: 'Data Matrix', barcodes: 'Barcodes', services: 'Services', portfolio: 'Portfolio', contact: 'Contact' },
  ru: { home: 'Главная', dataMatrix: 'Data Matrix', barcodes: 'Штрих-коды', services: 'Услуги', portfolio: 'Портфолио', contact: 'Контакт' },
};

const t = navLabels[lang] || navLabels.pl;
const prefix = lang === 'pl' ? '' : `/${lang}`;

const links = [
  { href: `${prefix}/`, label: t.home },
  { href: `${prefix}/data-matrix/`, label: t.dataMatrix },
  { href: `${prefix}/kody-kreskowe/`, label: t.barcodes },
  { href: `${prefix}/uslugi/`, label: t.services },
  { href: `${prefix}/realizacje/`, label: t.portfolio },
  { href: `${prefix}/kontakt/`, label: t.contact },
];

// Language switcher: derive base path from current URL
const basePath = pathname.replace(/^\/(en|ru)/, '') || '/';
const langLinks = [
  { code: 'PL', href: basePath, active: lang === 'pl' },
  { code: 'EN', href: `/en${basePath}`, active: lang === 'en' },
  { code: 'RU', href: `/ru${basePath}`, active: lang === 'ru' },
];
---

<header class="fixed w-full top-0 z-50 bg-white/90 backdrop-blur-md border-b border-navy-100">
  <nav class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16">
    <a href={`${prefix}/`} class="flex items-center gap-3">
      <img src="/logo.png" alt="Drukarnia WIPP" class="h-9 w-9 rounded-lg" width="36" height="36" />
      <span class="text-lg font-extrabold tracking-tight text-navy-900">WIPP <span class="font-medium text-gray-400">Drukarnia</span></span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-6">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'relative text-sm font-semibold transition-colors hover:text-navy-900',
              current === link.href
                ? 'text-navy-900 after:absolute after:-bottom-[21px] after:left-0 after:right-0 after:h-0.5 after:bg-accent-500'
                : 'text-gray-500'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:flex items-center gap-4">
      <!-- Language switcher -->
      <div class="flex items-center rounded-lg border border-navy-100 bg-navy-50 p-0.5 font-mono text-[11px] font-bold">
        {langLinks.map(l => (
          <a
            href={l.href}
            class:list={[
              'px-2 py-1 rounded-md transition-colors',
              l.active ? 'bg-white text-navy-900 shadow-sm' : 'text-gray-400 hover:text-navy-700'
            ]}
          >
            {l.code}
          </a>
        ))}
      </div>

      <!-- Phone CTA -->
      <a href="tel:+48604286423" class="inline-flex items-center gap-2 bg-navy-900 text-white text-sm font-bold px-4 py-2 rounded-lg hover:bg-navy-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        <span class="font-mono">604 286 423</span>
      </a>
    </div>

    <!-- Hamburger -->
    <button id="menu-toggle" class="lg:hidden p-2 text-navy-900" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-white border-t border-navy-100 shadow-lg">
    <ul class="px-4 py-3 space-y-1">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors',
              current === link.href ? 'text-navy-900 bg-navy-50' : 'text-gray-600 hover:bg-navy-50/60'
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-3 mt-2 border-t border-navy-100 flex items-center justify-between px-3 pb-2">
        <a href="tel:+48604286423" class="inline-flex items-center gap-2 text-sm font-bold text-navy-900 font-mono">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          604 286 423
        </a>
        <div class="flex items-center rounded-lg border border-navy-100 bg-navy-50 p-0.5 font-mono text-[11px] font-bold">
          {langLinks.map(l => (
            <a
              href={l.href}
              class:list={[
                'px-2 py-1 rounded-md transition-colors',
                l.active ? 'bg-white text-navy-900 shadow-sm' : 'text-gray-400'
              ]}
            >
              {l.code}
            </a>
          ))}
        </div>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    icon?.setAttribute('d', open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
  });
</script>
