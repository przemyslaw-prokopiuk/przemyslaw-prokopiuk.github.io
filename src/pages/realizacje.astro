---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DataMatrix from '../components/DataMatrix.astro';

const items = [
  { title: 'Etykiety Data Matrix', desc: 'Indywidualne kody Data Matrix na naklejkach samoprzylepnych' },
  { title: 'Naklejki produktowe', desc: 'Etykiety na opakowania z kodem kreskowym i grafiką' },
  { title: 'Wizytówki firmowe', desc: 'Eleganckie wizytówki na papierze kredowym' },
  { title: 'Ulotki reklamowe', desc: 'Materiały promocyjne w formacie A5 i DL' },
  { title: 'Koszulki z nadrukiem', desc: 'Personalizowane koszulki dla firm i drużyn' },
  { title: 'Plakaty i banery', desc: 'Druk wielkoformatowy plakatów i materiałów reklamowych' },
];
---

<Base
  title="Realizacje — portfolio drukarni | Drukarnia WIPP Białystok"
  description="Zobacz nasze realizacje: naklejki, etykiety, kody Data Matrix, wizytówki, ulotki, plakaty i koszulki z nadrukiem. Drukarnia WIPP Białystok."
>

  <PageHero
    eyebrow="Portfolio"
    title="Nasze realizacje"
    subtitle="Przykłady naszych prac — od kodów Data Matrix po materiały reklamowe."
  />

  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-5xl mx-auto px-4">

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        {items.map((item, i) => (
          <div class="relative bg-white rounded-2xl border border-navy-100 p-7 shadow-sm hover:shadow-lg transition-shadow overflow-hidden">
            <DataMatrix seed={i + 31} class="absolute -right-6 -bottom-8 w-28 text-navy-900/[0.04] rotate-12" />
            <div class="relative">
              <div class="w-11 h-11 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="font-extrabold tracking-tight text-navy-900">{item.title}</h3>
              <p class="text-sm text-gray-600 mt-1.5 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <p class="text-gray-500 mb-6">Chcesz zobaczyć więcej przykładów? Skontaktuj się z nami — chętnie pokażemy portfolio.</p>
        <a href="/kontakt/" class="btn btn-primary">Skontaktuj się</a>
      </div>

    </div>
  </section>

</Base>
