---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DataMatrix from '../components/DataMatrix.astro';
import QuoteForm from '../components/QuoteForm.astro';

const quoteLabels = {
  eyebrow: "Szybka wycena",
  title: "Skonfiguruj zapytanie o wycenę",
  intro: "Wypełnij formularz — przygotujemy gotową wiadomość w Twoim programie pocztowym. Bez telefonowania. Odpowiadamy w 24-48 h.",
  service: "Usługa",
  services: ["Kody Data Matrix", "Kody kreskowe / zmienne dane", "Naklejki i etykiety", "Druk cyfrowy (wizytówki, ulotki...)", "Koszulki z nadrukiem", "Inne / nietypowe zlecenie"],
  size: "Wymiary etykiety / formatu",
  sizePlaceholder: "np. 50 × 30 mm",
  material: "Materiał",
  materialPlaceholder: "np. papier, folia — lub „proszę o doradztwo”",
  quantity: "Nakład",
  quantityPlaceholder: "np. 10 000 szt.",
  deadline: "Termin realizacji",
  deadlinePlaceholder: "np. do 20 lipca / ekspres 24-48 h",
  notes: "Dodatkowe informacje",
  notesPlaceholder: "Opisz zamówienie — np. czy dostarczysz plik z kodami, kolory, uszlachetnienia...",
  submit: "Przygotuj e-mail z zapytaniem",
  gmail: "Otwórz w Gmailu",
  copy: "Skopiuj treść wiadomości",
  copied: "Skopiowano!",
  hint: "Kliknięcie otworzy Twój program pocztowy z gotową wiadomością do wippdrukarnia@gmail.com — nic nie wysyłamy automatycznie.\nNic się nie otworzyło? Użyj „Otwórz w Gmailu” lub skopiuj treść.",
  subject: "Zapytanie o wycenę — formularz ze strony",
  intro2: "Dzień dobry, proszę o wycenę:",
  attachNote: "P.S. Jeśli masz już plik PDF z kodami lub projektem — załącz go do tej wiadomości przed wysłaniem.",
};
---

<Base
  title="Kontakt — Drukarnia WIPP Białystok | Kombatantów 7A"
  description="Skontaktuj się z Drukarnią WIPP w Białymstoku. Tel: 604 286 423. Adres: ul. Kombatantów 7A, 15-110 Białystok. Pn-Pt 07:00-15:00."
>

  <PageHero
    eyebrow="Jesteśmy do dyspozycji"
    title="Kontakt"
    subtitle="Zadzwoń, napisz lub odwiedź nas. Chętnie przygotujemy wycenę."
  />

  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-5xl mx-auto px-4">

      <!-- Contact cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">

        <a href="tel:+48604286423" class="group bg-white rounded-2xl border border-navy-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-6 text-center">
          <div class="w-14 h-14 bg-navy-50 text-navy-700 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-navy-900 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <h2 class="font-extrabold tracking-tight text-navy-900 mb-1">Telefon</h2>
          <p class="font-mono font-bold text-navy-700 group-hover:text-accent-600 transition-colors">604 286 423</p>
        </a>

        <a href="mailto:wippdrukarnia@gmail.com" class="group bg-white rounded-2xl border border-navy-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-6 text-center">
          <div class="w-14 h-14 bg-navy-50 text-navy-700 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-navy-900 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h2 class="font-extrabold tracking-tight text-navy-900 mb-1">Email</h2>
          <p class="font-mono text-xs font-bold text-navy-700 group-hover:text-accent-600 transition-colors break-all">wippdrukarnia@gmail.com</p>
        </a>

        <div class="bg-white rounded-2xl border border-navy-100 shadow-sm p-6 text-center">
          <div class="w-14 h-14 bg-navy-50 text-navy-700 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h2 class="font-extrabold tracking-tight text-navy-900 mb-1">Adres</h2>
          <p class="text-gray-600 text-sm leading-relaxed">ul. Kombatantów 7A<br />15-110 Białystok</p>
        </div>

        <div class="bg-white rounded-2xl border border-navy-100 shadow-sm p-6 text-center">
          <div class="w-14 h-14 bg-navy-50 text-navy-700 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h2 class="font-extrabold tracking-tight text-navy-900 mb-1">Godziny otwarcia</h2>
          <p class="text-gray-600 text-sm leading-relaxed font-mono">Pn-Pt: 07:00-15:00<br />Sb-Nd: zamknięte</p>
        </div>

      </div>

      <!-- Quote configurator -->
      <QuoteForm labels={quoteLabels} />

      <!-- Email CTA -->
      <div class="relative overflow-hidden bg-navy-950 rounded-3xl p-8 md:p-14 text-center text-white mb-16">
        <div class="absolute inset-0 bg-grid-dark" aria-hidden="true"></div>
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-accent-500/15 rounded-full blur-3xl" aria-hidden="true"></div>
        <DataMatrix seed={13} class="absolute -left-10 -bottom-12 w-48 text-white/[0.06] -rotate-12" />
        <div class="relative">
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-4">Wolisz napisać bezpośrednio?</h2>
          <p class="text-navy-200 mb-8 max-w-xl mx-auto leading-relaxed">
            Opisz swoje zamówienie — ilość, format, materiał, termin realizacji.
            Odpowiemy z wyceną tak szybko, jak to możliwe.
          </p>
          <a href="mailto:wippdrukarnia@gmail.com?subject=Zapytanie%20o%20wycenę"
            class="btn btn-light text-base sm:text-lg w-full sm:w-auto">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            wippdrukarnia@gmail.com
          </a>
        </div>
      </div>

      <!-- Map -->
      <div>
        <div class="text-center mb-8">
          <p class="eyebrow text-accent-600 mb-3">Lokalizacja</p>
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Gdzie nas znajdziesz</h2>
        </div>
        <div class="rounded-2xl overflow-hidden border border-navy-100 shadow-md">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2005.6354698659102!2d23.159546482128956!3d53.150002268782195!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471ffc3f8d5fdacd%3A0x1b11bab1ec2e71c2!2sWipp%20Piotr%20Prokopiuk!5e0!3m2!1spl!2spl!4v1748554345172!5m2!1spl!2spl"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokalizacja Drukarni WIPP — Kombatantów 7A, Białystok">
          </iframe>
        </div>
        <div class="mt-6 text-center">
          <a href="https://www.google.com/maps/dir/?api=1&destination=Kombatantów+7A,+15-110+Białystok"
            target="_blank" rel="noopener"
            class="inline-flex items-center gap-1.5 text-navy-700 font-bold hover:text-accent-600 transition-colors">
            Wyznacz trasę
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>

    </div>
  </section>

</Base>
