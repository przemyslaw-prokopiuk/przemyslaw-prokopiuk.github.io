---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import CodeGenerator from '../components/CodeGenerator.astro';

const genLabels = {
  eyebrow: "Darmowe narzędzie",
  title: "Generator kodów online",
  intro: "Wygeneruj i pobierz własny kod QR, Data Matrix lub kod kreskowy — za darmo, bez rejestracji. Dokładnie taką jakość drukujemy na etykietach.",
  disclaimer: "Ważne: to bezpłatne narzędzie poglądowe. Jako drukarnia nie generujemy kodów na zlecenie — drukujemy kody dostarczone przez klienta w pliku PDF, np. wydane przez systemy znakowania produktów.",
  typeLabel: "Rodzaj kodu",
  types: { qr: "Kod QR", dm: "Data Matrix", gs1: "GS1 Data Matrix", ean: "EAN-13", c128: "Code 128" },
  textLabel: "Treść kodu (link, tekst lub cyfry)",
  placeholder: "np. https://twoja-strona.pl",
  generate: "Generuj kod",
  download: "Pobierz PNG",
  note: "Kod QR odczytasz aparatem każdego telefonu. Data Matrix wymaga aplikacji ze skanerem kodów 2D (np. Google Lens) lub czytnika przemysłowego — dlatego to właśnie on jest standardem w znakowaniu produktów. GS1 Data Matrix to Data Matrix o treści w standardzie GS1 — format (01) GTIN + (21) numer seryjny, taki jak w systemach znakowania produktów. Uwaga: aplikacje systemów znakowania weryfikują wyłącznie kody wydane przez operatora systemu — kody z generatora mają charakter poglądowy.",
  previewHint: "Tutaj pojawi się Twój kod",
  errInvalid: "Nie udało się wygenerować kodu — sprawdź treść.",
  errEan: "EAN-13: podaj 12 cyfr (sumę kontrolną wyliczymy automatycznie) albo 13 cyfr z poprawną sumą kontrolną — ostatnia cyfra wynika z pozostałych.",
};

const codeTypes = [
  {
    title: 'Kody Data Matrix',
    desc: 'Nasza wiodąca specjalizacja — unikalne kody dla systemów znakowania produktów. Każda sztuka produktu z indywidualnym kodem.',
    href: '/data-matrix/',
    linkLabel: 'Zobacz specjalizację',
    featured: true,
  },
  {
    title: 'Kody EAN-13 / EAN-8',
    desc: 'Standardowe kody handlowe na produkty detaliczne. Druk zgodny ze standardem GS1 — gwarantowana czytelność przy każdej kasie i w każdym skanerze.',
  },
  {
    title: 'Kody QR',
    desc: 'Kody QR z linkami do stron, menu, kart produktów i promocji. Statyczne lub ze zmiennymi danymi — inny link na każdej etykiecie.',
  },
  {
    title: 'GS1-128 / Code 128',
    desc: 'Kody logistyczne na opakowania zbiorcze i palety: numery partii, daty ważności, numery SSCC. Etykiety logistyczne zgodne z GS1.',
  },
  {
    title: 'Numeracja seryjna',
    desc: 'Etykiety z kolejnymi numerami, unikalnymi kodami rabatowymi lub dowolnym tekstem zmiennym — z Twojego pliku PDF lub z prostą numeracją przygotowaną przez nas.',
  },
  {
    title: 'Naklejki gwarancyjne i plomby',
    desc: 'Etykiety zabezpieczające z numeracją — plomby gwarancyjne, naklejki serwisowe i inwentaryzacyjne z kodem kreskowym.',
  },
];

const steps = [
  {
    title: 'Przesyłasz dane',
    desc: 'Wystarczy plik PDF z kodami albo numerami. Nie masz pliku? Prostą numerację seryjną przygotujemy za Ciebie.',
  },
  {
    title: 'Przygotowujemy projekt',
    desc: 'Projektujemy etykietę, dobieramy materiał i weryfikujemy czytelność kodów przed drukiem.',
  },
  {
    title: 'Drukujemy i dostarczamy',
    desc: 'Każda etykieta z innym kodem, w ustalonej kolejności — gotowa do naklejenia na produkt lub opakowanie.',
  },
];

const faqItems = [
  {
    question: 'Jakie rodzaje kodów kreskowych drukujecie?',
    answer: 'Drukujemy wszystkie popularne kody: EAN-8 i EAN-13, Code 128, GS1-128, ITF-14, kody QR oraz kody Data Matrix. Doradzimy, który rodzaj kodu sprawdzi się w Twoim zastosowaniu — handlowym, logistycznym czy produkcyjnym.',
  },
  {
    question: 'Jak przygotować plik z kodami do druku etykiet?',
    answer: 'Najlepiej sprawdza się plik PDF, w którym kody ułożone są w wymaganej kolejności. Prześlij nam plik, a zweryfikujemy go przed drukiem i doradzimy, jeśli coś trzeba poprawić.',
  },
  {
    question: 'Czy drukujecie etykiety z numeracją seryjną?',
    answer: 'Tak — etykiety ze zmiennymi danymi to nasza codzienność. Drukujemy dowolne zakresy numeracji, unikalne kody rabatowe, numery inwentaryzacyjne i plomby gwarancyjne. Numerację możemy wygenerować sami lub wykorzystać Twój plik.',
  },
  {
    question: 'Na jakich materiałach drukujecie kody?',
    answer: 'Na papierze samoprzylepnym, folii PP i PET (matowej lub błyszczącej) oraz materiałach specjalnych odpornych na wilgoć, ścieranie i niskie temperatury. Dobierzemy materiał do warunków, w jakich etykieta będzie używana.',
  },
  {
    question: 'Czym jest GS1 Sunrise 2027?',
    answer: 'Sunrise 2027 to globalna inicjatywa organizacji GS1: do końca 2027 roku kasy i systemy sklepowe na całym świecie mają być gotowe na odczyt kodów 2D — GS1 Data Matrix oraz GS1 QR (Digital Link). Kody 2D mieszczą znacznie więcej danych niż tradycyjny EAN: datę ważności, numer partii, numer seryjny czy link do strony produktu. W Polsce list intencyjny podpisały już m.in. sieci Biedronka, Żabka, Auchan i Carrefour.',
  },
  {
    question: 'Czy muszę już teraz drukować kody 2D na etykietach?',
    answer: 'W okresie przejściowym produkty mogą być oznaczane podwójnie: dotychczasowym kodem EAN i nowym kodem 2D na tej samej etykiecie. Producenci, którzy zaczną wcześniej, unikną kosztownej wymiany etykiet pod presją czasu. Drukujemy etykiety z podwójnym oznaczeniem (EAN-13 + GS1 Data Matrix lub GS1 QR) już dziś — doradzimy rozmieszczenie kodów zgodnie z wytycznymi GS1.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Base
  title="Druk kodów kreskowych i kodów 2D GS1 — etykiety ze zmiennymi danymi | WIPP Białystok"
  description="Drukujemy kody kreskowe EAN, QR, GS1-128 i Data Matrix, kody 2D GS1 (Sunrise 2027) oraz etykiety ze zmiennymi danymi i numeracją seryjną. Wystarczy plik PDF z kodami."
  schema={faqSchema}
>

  <PageHero
    eyebrow="Znakowanie produktów"
    title="Druk kodów kreskowych"
    highlight="i etykiet ze zmiennymi danymi"
    subtitle="Od kodów EAN po unikalne numery seryjne — drukujemy każdy rodzaj kodu na etykietach samoprzylepnych. Wystarczy plik PDF z kodami."
  />

  <CodeGenerator labels={genLabels} />

  <!-- Code types -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-accent-600 mb-3">Rodzaje kodów</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Jakie kody drukujemy?</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {codeTypes.map(c => (
          <div class:list={[
            'relative bg-white rounded-2xl p-7 shadow-sm hover:shadow-lg transition-shadow',
            c.featured ? 'border border-accent-500/40 ring-1 ring-accent-500/20' : 'border border-navy-100'
          ]}>
            {c.featured && <span class="absolute top-5 right-5 font-mono text-[10px] font-bold uppercase tracking-widest text-accent-600 bg-accent-500/10 rounded-full px-3 py-1">Specjalizacja</span>}
            <div class="w-12 h-12 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
            </div>
            <h3 class="text-lg font-extrabold tracking-tight mb-2">{c.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{c.desc}</p>
            {c.href && (
              <a href={c.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 hover:text-accent-600 transition-colors">
                {c.linkLabel}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-accent-600 mb-3">Druk danych zmiennych</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Jak to działa?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {steps.map((s, i) => (
          <div class="relative bg-white rounded-2xl border border-navy-100 p-7 shadow-sm">
            <span class="font-mono text-sm font-bold text-accent-600 bg-accent-500/10 rounded-lg px-3 py-2 inline-block mb-4">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-lg font-extrabold tracking-tight mb-2">{s.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center text-gray-600 max-w-2xl mx-auto">
        Druk danych zmiennych (Variable Data Printing) pozwala wydrukować tysiące etykiet, z których każda jest inna —
        bez zmiany matryc i bez dopłat za „wersje". Idealne do numeracji seryjnej, kodów rabatowych i znakowania partii produkcyjnych.
      </p>
    </div>
  </section>

  <!-- Sunrise 2027 -->
  <section class="pb-16 md:pb-24 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="relative bg-white rounded-3xl border border-accent-500/40 ring-1 ring-accent-500/20 p-8 md:p-12 shadow-sm overflow-hidden">
        <svg class="absolute -right-8 -bottom-10 w-48 text-accent-500/[0.07] rotate-12" fill="currentColor" viewBox="0 0 14 14" aria-hidden="true"><rect x="0" y="0" width="14" height="14" fill="none"/><rect x="0" y="0" width="1" height="14"/><rect x="0" y="13" width="14" height="1"/><rect x="2" y="2" width="2" height="2"/><rect x="6" y="2" width="2" height="2"/><rect x="10" y="3" width="2" height="2"/><rect x="3" y="6" width="2" height="2"/><rect x="8" y="7" width="2" height="2"/><rect x="5" y="10" width="2" height="2"/><rect x="10" y="10" width="2" height="2"/></svg>
        <div class="relative">
          <p class="eyebrow text-accent-600 mb-4">GS1 Sunrise 2027</p>
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-4">Kody 2D zastąpią tradycyjne kody EAN</h2>
          <p class="text-gray-600 leading-relaxed mb-6 max-w-2xl">
            Do końca 2027 roku kasy sklepowe na całym świecie mają być gotowe na odczyt kodów 2D —
            <strong>GS1 Data Matrix</strong> i <strong>GS1 QR</strong>. W Polsce list intencyjny podpisały już
            m.in. Biedronka, Żabka, Auchan i Carrefour. W okresie przejściowym produkty oznacza się podwójnie:
            kodem EAN i kodem 2D na tej samej etykiecie.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'Drukujemy etykiety z kodami GS1 Data Matrix i GS1 QR',
              'Podwójne oznaczenie: EAN-13 + kod 2D na jednej etykiecie',
              'Doradzamy format i rozmieszczenie kodów zgodnie z wytycznymi GS1',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <span class="shrink-0 w-5 h-5 mt-0.5 rounded-md bg-navy-900 text-white flex items-center justify-center">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <a href="/kontakt/" class="btn btn-primary">Przygotuj etykiety na kody 2D</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="eyebrow text-accent-600 mb-3">FAQ</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Najczęstsze pytania o druk kodów</h2>
      </div>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="group bg-white rounded-2xl border border-navy-100 shadow-sm open:shadow-md transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-bold text-navy-950 hover:text-navy-700 transition-colors">
              {item.question}
              <span class="shrink-0 w-8 h-8 rounded-full border border-navy-200 flex items-center justify-center text-navy-500 transition-all duration-200 group-open:rotate-45 group-open:bg-navy-900 group-open:border-navy-900 group-open:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed whitespace-pre-line">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Potrzebujesz etykiet z kodami?"
    text="Prześlij plik z danymi lub opisz zamówienie — przygotujemy wycenę w ciągu 24-48 godzin."
    primaryHref="/kontakt/"
    primaryLabel="Zamów wycenę"
    secondaryHref="tel:+48604286423"
    secondaryLabel="Zadzwoń: 604 286 423"
  />

</Base>
