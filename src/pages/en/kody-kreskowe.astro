---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import CodeGenerator from '../../components/CodeGenerator.astro';

const genLabels = {
  eyebrow: "Free tool",
  title: "Online code generator",
  intro: "Generate and download your own QR, Data Matrix, or barcode — free, no sign-up. This is exactly the quality we print on labels.",
  disclaimer: "Important: this is a free demonstration tool. As a printing house we do not generate codes on request — we print codes supplied by the client in a PDF file, e.g. issued by product marking systems.",
  typeLabel: "Code type",
  types: { qr: "QR code", dm: "Data Matrix", gs1: "GS1 Data Matrix", ean: "EAN-13", c128: "Code 128" },
  textLabel: "Code content (link, text, or digits)",
  placeholder: "e.g. https://your-website.com",
  generate: "Generate code",
  download: "Download PNG",
  note: "A QR code can be read by any phone camera. Data Matrix requires a 2D scanner app (e.g. Google Lens) or an industrial reader — which is exactly why it's the standard in product marking. GS1 Data Matrix is a Data Matrix with GS1-structured content — (01) GTIN + (21) serial number, the format used in product marking systems. Note: marking-system apps only verify codes issued by the system operator — generator codes are for demonstration.",
  previewHint: "Your code will appear here",
  errInvalid: "Could not generate the code — check the content.",
  errEan: "EAN-13: enter 12 digits (we'll compute the check digit automatically) or 13 digits with a valid check digit — the last digit is derived from the others.",
};

const codeTypes = [
  {
    title: 'Data Matrix codes',
    desc: 'Our leading specialty — unique codes for product marking systems. Every product unit gets an individual code.',
    href: '/en/data-matrix/',
    linkLabel: 'See our specialty',
    featured: true,
  },
  {
    title: 'EAN-13 / EAN-8 barcodes',
    desc: 'Standard retail barcodes for consumer products. GS1-compliant printing — guaranteed readability at every checkout and scanner.',
  },
  {
    title: 'QR codes',
    desc: 'QR codes linking to websites, menus, product pages and promotions. Static or with variable data — a different link on every label.',
  },
  {
    title: 'GS1-128 / Code 128',
    desc: 'Logistics barcodes for bulk packaging and pallets: batch numbers, expiry dates, SSCC numbers. GS1-compliant logistics labels.',
  },
  {
    title: 'Serial numbering',
    desc: 'Labels with sequential numbers, unique discount codes, or any variable text — from your PDF file or with simple numbering prepared by us.',
  },
  {
    title: 'Warranty seals & security labels',
    desc: 'Numbered security labels — warranty seals, service stickers, and asset/inventory labels with barcodes.',
  },
];

const steps = [
  {
    title: 'Send your data',
    desc: 'A PDF file with codes or numbers is all we need. No file? We can prepare simple serial numbering for you.',
  },
  {
    title: 'We prepare the design',
    desc: 'We design the label, select the material, and verify code readability before printing.',
  },
  {
    title: 'We print and deliver',
    desc: 'Every label with a different code, in the agreed order — ready to apply to your product or packaging.',
  },
];

const faqItems = [
  {
    question: 'What types of barcodes do you print?',
    answer: 'We print all common barcode types: EAN-8 and EAN-13, Code 128, GS1-128, ITF-14, QR codes, and Data Matrix codes. We can advise which code type fits your use case — retail, logistics, or production.',
  },
  {
    question: 'How do I prepare a code file for label printing?',
    answer: 'A PDF file works best, with the codes arranged in the required order. Send us your file — we will verify it before printing and advise if anything needs fixing.',
  },
  {
    question: 'Do you print labels with serial numbering?',
    answer: 'Yes — variable data labels are our daily work. We print any numbering ranges, unique discount codes, inventory numbers, and warranty seals. We can generate the numbering ourselves or use your file.',
  },
  {
    question: 'What materials do you print codes on?',
    answer: 'Self-adhesive paper, PP and PET foil (matte or glossy), and specialty materials resistant to moisture, abrasion, and low temperatures. We will match the material to the conditions your labels will face.',
  },
  {
    question: 'What is GS1 Sunrise 2027?',
    answer: 'Sunrise 2027 is a global GS1 initiative: by the end of 2027, retail checkouts and store systems worldwide are expected to be ready to read 2D codes — GS1 Data Matrix and GS1 QR (Digital Link). 2D codes hold far more data than a traditional EAN: expiry date, batch number, serial number, or a link to the product page. In Poland, retail chains including Biedronka, Żabka, Auchan, and Carrefour have already signed letters of intent.',
  },
  {
    question: 'Do I need to print 2D codes on my labels already?',
    answer: 'During the transition period, products can carry dual marking: the existing EAN code and the new 2D code on the same label. Producers who start early avoid a costly label changeover under time pressure. We print dual-marked labels (EAN-13 + GS1 Data Matrix or GS1 QR) today — and we will advise on code placement per GS1 guidelines.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Base
  lang="en"
  title="Barcode & GS1 2D code printing — variable data labels | WIPP Białystok"
  description="We print EAN, QR, GS1-128, and Data Matrix barcodes, GS1 2D codes (Sunrise 2027), plus variable data labels with serial numbering. Just send a PDF file with codes."
  schema={faqSchema}
>

  <PageHero
    eyebrow="Product marking"
    title="Barcode printing"
    highlight="and variable data labels"
    subtitle="From EAN codes to unique serial numbers — we print every kind of code on self-adhesive labels. All it takes is a PDF file with codes."
  />

  <CodeGenerator labels={genLabels} />

  <!-- Code types -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-accent-600 mb-3">Code types</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">What codes do we print?</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {codeTypes.map(c => (
          <div class:list={[
            'relative bg-white rounded-2xl p-7 shadow-sm hover:shadow-lg transition-shadow',
            c.featured ? 'border border-accent-500/40 ring-1 ring-accent-500/20' : 'border border-navy-100'
          ]}>
            {c.featured && <span class="absolute top-5 right-5 font-mono text-[10px] font-bold uppercase tracking-widest text-accent-600 bg-accent-500/10 rounded-full px-3 py-1">Specialty</span>}
            <div class="w-12 h-12 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
            </div>
            <h3 class="text-lg font-extrabold tracking-tight mb-2">{c.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{c.desc}</p>
            {c.href && (
              <a href={c.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 hover:text-accent-600 transition-colors">
                {c.linkLabel}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-accent-600 mb-3">Variable data printing</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">How does it work?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {steps.map((s, i) => (
          <div class="relative bg-white rounded-2xl border border-navy-100 p-7 shadow-sm">
            <span class="font-mono text-sm font-bold text-accent-600 bg-accent-500/10 rounded-lg px-3 py-2 inline-block mb-4">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-lg font-extrabold tracking-tight mb-2">{s.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center text-gray-600 max-w-2xl mx-auto">
        Variable Data Printing lets you print thousands of labels where every single one is different —
        no plate changes, no surcharges for "versions". Perfect for serial numbering, discount codes, and production batch marking.
      </p>
    </div>
  </section>

  <!-- Sunrise 2027 -->
  <section class="pb-16 md:pb-24 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="relative bg-white rounded-3xl border border-accent-500/40 ring-1 ring-accent-500/20 p-8 md:p-12 shadow-sm overflow-hidden">
        <svg class="absolute -right-8 -bottom-10 w-48 text-accent-500/[0.07] rotate-12" fill="currentColor" viewBox="0 0 14 14" aria-hidden="true"><rect x="0" y="0" width="14" height="14" fill="none"/><rect x="0" y="0" width="1" height="14"/><rect x="0" y="13" width="14" height="1"/><rect x="2" y="2" width="2" height="2"/><rect x="6" y="2" width="2" height="2"/><rect x="10" y="3" width="2" height="2"/><rect x="3" y="6" width="2" height="2"/><rect x="8" y="7" width="2" height="2"/><rect x="5" y="10" width="2" height="2"/><rect x="10" y="10" width="2" height="2"/></svg>
        <div class="relative">
          <p class="eyebrow text-accent-600 mb-4">GS1 Sunrise 2027</p>
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-4">2D codes will replace traditional EAN barcodes</h2>
          <p class="text-gray-600 leading-relaxed mb-6 max-w-2xl">
            By the end of 2027, retail checkouts worldwide are expected to read 2D codes —
            <strong>GS1 Data Matrix</strong> and <strong>GS1 QR</strong>. In Poland, chains including
            Biedronka, Żabka, Auchan, and Carrefour have already signed letters of intent. During the transition,
            products carry dual marking: the EAN code and the 2D code on the same label.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'We print labels with GS1 Data Matrix and GS1 QR codes',
              'Dual marking: EAN-13 + a 2D code on one label',
              'We advise on code format and placement per GS1 guidelines',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <span class="shrink-0 w-5 h-5 mt-0.5 rounded-md bg-navy-900 text-white flex items-center justify-center">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <a href="/en/kontakt/" class="btn btn-primary">Get your labels ready for 2D codes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="eyebrow text-accent-600 mb-3">FAQ</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Frequently asked questions about code printing</h2>
      </div>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="group bg-white rounded-2xl border border-navy-100 shadow-sm open:shadow-md transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-bold text-navy-950 hover:text-navy-700 transition-colors">
              {item.question}
              <span class="shrink-0 w-8 h-8 rounded-full border border-navy-200 flex items-center justify-center text-navy-500 transition-all duration-200 group-open:rotate-45 group-open:bg-navy-900 group-open:border-navy-900 group-open:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed whitespace-pre-line">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Need labels with codes?"
    text="Send us your data file or describe your order — we'll prepare a quote within 24-48 hours."
    primaryHref="/en/kontakt/"
    primaryLabel="Get a quote"
    secondaryHref="tel:+48604286423"
    secondaryLabel="Call: 604 286 423"
  />

</Base>
