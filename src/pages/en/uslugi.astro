---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';
---

<Base
  lang="en"
  title="Printing services — stickers, labels, digital printing | WIPP Białystok"
  description="We offer printing of stickers, self-adhesive labels, Data Matrix codes, business cards, flyers, posters, and custom t-shirts. WIPP Printing House Białystok."
>

  <PageHero
    eyebrow="What we do"
    title="Printing services"
    subtitle="From Data Matrix codes to business cards — we handle every order."
  />

  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-6">

      <!-- Data Matrix -->
      <div class="relative bg-white rounded-2xl border border-accent-500/40 ring-1 ring-accent-500/20 p-8 shadow-sm hover:shadow-lg transition-shadow">
        <span class="absolute top-6 right-6 font-mono text-[10px] font-bold uppercase tracking-widest text-accent-600 bg-accent-500/10 rounded-full px-3 py-1">Specialty</span>
        <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
        </div>
        <h2 class="text-xl font-extrabold tracking-tight mb-3">Data Matrix codes — product marking</h2>
        <p class="text-gray-600 leading-relaxed mb-5">
          Our leading specialty. The client provides us with files containing unique Data Matrix codes,
          and we print them on stickers in the required order and layout — both individual labels
          and aggregation codes on bulk packages.
        </p>
        <a href="/en/data-matrix/" class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 hover:text-accent-600 transition-colors">
          Learn more about Data Matrix codes
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>

      <!-- Barcodes & variable data -->
      <div class="bg-white rounded-2xl border border-navy-100 p-8 shadow-sm hover:shadow-lg transition-shadow">
        <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6v12M8 6v12M12 6v8M12 17.99V18M16 6v8M16 17.99V18M20 6v12" /></svg>
        </div>
        <h2 class="text-xl font-extrabold tracking-tight mb-3">Barcodes and variable data labels</h2>
        <p class="text-gray-600 leading-relaxed mb-5">
          EAN, QR, GS1-128 codes, serial numbering, and warranty seals. Variable data printing
          from your PDF file — every label different, no surcharges for versions.
        </p>
        <a href="/en/kody-kreskowe/" class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 hover:text-accent-600 transition-colors">
          Learn more about code printing
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>

      <!-- Stickers -->
      <div class="bg-white rounded-2xl border border-navy-100 p-8 shadow-sm hover:shadow-lg transition-shadow">
        <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" /></svg>
        </div>
        <h2 class="text-xl font-extrabold tracking-tight mb-3">Stickers and self-adhesive labels</h2>
        <p class="text-gray-600 leading-relaxed">
          Printing on self-adhesive paper, transparent foil, matte foil, and other specialty materials.
          Product labels, promotional stickers, barcodes, security stickers.
          We handle both short and long runs.
        </p>
      </div>

      <!-- Digital printing -->
      <div class="bg-white rounded-2xl border border-navy-100 p-8 shadow-sm hover:shadow-lg transition-shadow">
        <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
        </div>
        <h2 class="text-xl font-extrabold tracking-tight mb-3">Digital and offset printing</h2>
        <p class="text-gray-600 leading-relaxed">
          Business cards, flyers, posters, brochures, catalogues, letterheads. Printing on offset paper,
          coated paper, and cardboard. Even small runs with express 24-48h option.
        </p>
      </div>

      <!-- T-shirts -->
      <div class="md:col-span-2 bg-white rounded-2xl border border-navy-100 p-8 shadow-sm hover:shadow-lg transition-shadow">
        <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        </div>
        <h2 class="text-xl font-extrabold tracking-tight mb-3">Custom printed t-shirts</h2>
        <p class="text-gray-600 leading-relaxed">
          T-shirt printing, iron-on transfers, clothing personalization. We handle orders
          starting from just one piece — perfect for teams, school classes, companies, and events.
        </p>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Have a non-standard order?"
    text="Non-standard orders are our specialty. Contact us — we'll advise and provide a quote."
    primaryHref="/en/kontakt/"
    primaryLabel="Get a quote"
  />

</Base>
