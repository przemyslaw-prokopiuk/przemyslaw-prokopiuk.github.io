---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DataMatrix from '../../components/DataMatrix.astro';

const items = [
  { title: 'Data Matrix labels', desc: 'Individual Data Matrix codes on self-adhesive stickers' },
  { title: 'Product stickers', desc: 'Packaging labels with barcodes and graphics' },
  { title: 'Business cards', desc: 'Elegant business cards on coated paper' },
  { title: 'Advertising flyers', desc: 'Promotional materials in A5 and DL formats' },
  { title: 'Custom t-shirts', desc: 'Personalized t-shirts for companies and teams' },
  { title: 'Posters & banners', desc: 'Large-format poster and advertising material printing' },
];
---

<Base
  lang="en"
  title="Portfolio — our work | WIPP Printing House Białystok"
  description="See our work: stickers, labels, Data Matrix codes, business cards, flyers, posters, and custom t-shirts. WIPP Printing House Białystok."
>

  <PageHero
    eyebrow="Portfolio"
    title="Our work"
    subtitle="Examples of our projects — from Data Matrix codes to promotional materials."
  />

  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-5xl mx-auto px-4">

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        {items.map((item, i) => (
          <div class="relative bg-white rounded-2xl border border-navy-100 p-7 shadow-sm hover:shadow-lg transition-shadow overflow-hidden">
            <DataMatrix seed={i + 31} class="absolute -right-6 -bottom-8 w-28 text-navy-900/[0.04] rotate-12" />
            <div class="relative">
              <div class="w-11 h-11 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="font-extrabold tracking-tight text-navy-900">{item.title}</h3>
              <p class="text-sm text-gray-600 mt-1.5 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <p class="text-gray-500 mb-6">Want to see more examples? Contact us — we'll be happy to show our portfolio.</p>
        <a href="/en/kontakt/" class="btn btn-primary">Contact us</a>
      </div>

    </div>
  </section>

</Base>
