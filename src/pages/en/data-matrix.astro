---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const faqItems = [
  {
    question: "What is a Data Matrix code?",
    answer: "A Data Matrix code is a two-dimensional barcode that can store a large amount of information in a small area. Each product unit receives a unique code containing a GTIN number, serial number, and verification key. These codes are used in product marking systems across many markets."
  },
  {
    question: "Which products require Data Matrix codes?",
    answer: "Data Matrix codes are required in many industries, including: tobacco products, footwear, perfumes, tires, pharmaceuticals, dairy, bottled water, beer, clothing, confectionery, tea, coffee, and electronics. The list of categories continues to grow."
  },
  {
    question: "Why is Data Matrix code printing difficult?",
    answer: "Each individual product unit must have its own unique Data Matrix code. For example, a bulk package of 30 candy bars requires 30 individual stickers + 1 aggregation code on the box. This is variable data printing, which requires specialized equipment and experience."
  },
  {
    question: "What does a Data Matrix code contain?",
    answer: "A Data Matrix code contains at least four groups of information: GTIN (Global Trade Item Number), product serial number, verification key, and cryptographic code. Together, they form a unique identifier that allows tracking each product unit in the supply chain."
  },
  {
    question: "What does the ordering process look like at WIPP?",
    answer: "The process is simple:\n1) You send us a file with unique Data Matrix codes.\n2) We prepare the label design according to system requirements.\n3) We print the stickers with individual codes in the required order.\n4) We deliver the finished labels — each with a unique code, ready to apply to the product."
  },
  {
    question: "How much does Data Matrix code printing cost?",
    answer: "The price depends on the quantity, label size, and material. Contact us by phone (604 286 423) or email — we'll prepare an individual quote within 24-48 hours."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const challenges = [
  {
    title: "Each label is unique",
    html: `Unlike standard printing where all stickers are identical,
      <strong>each individual product unit</strong> must have its own unique Data Matrix code.
      Example: a bulk package of 30 candy bars requires 30 different stickers + 1 aggregation code on the box.`
  },
  {
    title: "Variable Data Printing",
    html: `Each label contains different data — this requires specialized software and printing equipment
      adapted for high-speed, high-precision variable data printing. An error in a single code means
      rejection of the entire batch.`
  },
  {
    title: "Code aggregation and hierarchy",
    html: `The system requires not only unit-level codes, but also <strong>aggregation codes</strong>
      on bulk packages and pallets. The entire hierarchy must be consistent and registered.`
  }
];

const offers = [
  { title: "Printing supplied codes", desc: "The client provides us with files containing unique Data Matrix codes, and we print them on stickers in the required order and layout." },
  { title: "Aggregation codes", desc: "Labels for bulk packages and pallets with codes linking individual units into a hierarchy." },
  { title: "High volume, fast turnaround", desc: "We handle large volumes of variable data printing with short turnaround times." },
  { title: "Experience since 1997", desc: "Over 25 years in the printing industry. We know how to print precisely and reliably." }
];
---

<Base
  lang="en"
  title="Data Matrix code printing — unique labels | WIPP Printing House Białystok"
  description="Printing individual Data Matrix codes on stickers. We specialize in unique label printing for every product unit. WIPP Printing House Białystok."
  schema={faqSchema}
>

  <PageHero
    eyebrow="Our specialty"
    title="Data Matrix code printing"
    highlight="Unique labels for every product"
    subtitle="We specialize in printing unique Data Matrix codes on stickers — each product unit receives an individual code."
  />

  <!-- Why it's hard -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-8">Why does Data Matrix code printing require a specialist?</h2>
      <div class="space-y-5">
        {challenges.map((c, i) => (
          <div class="bg-white rounded-2xl border border-navy-100 p-6 md:p-8 shadow-sm">
            <div class="flex items-start gap-5">
              <span class="shrink-0 font-mono text-sm font-bold text-accent-600 bg-accent-500/10 rounded-lg px-3 py-2">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-extrabold tracking-tight text-navy-900 mb-2">{c.title}</h3>
                <p class="text-gray-600 leading-relaxed" set:html={c.html} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we deliver -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-10">What do we offer?</h2>
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-8">
        {offers.map(o => (
          <div class="flex gap-4">
            <div class="shrink-0 w-11 h-11 bg-navy-900 text-white rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <h3 class="font-extrabold tracking-tight text-navy-900 mb-1.5">{o.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{o.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="eyebrow text-accent-600 mb-3">FAQ</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Frequently asked questions about Data Matrix codes</h2>
      </div>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="group bg-white rounded-2xl border border-navy-100 shadow-sm open:shadow-md transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-bold text-navy-950 hover:text-navy-700 transition-colors">
              {item.question}
              <span class="shrink-0 w-8 h-8 rounded-full border border-navy-200 flex items-center justify-center text-navy-500 transition-all duration-200 group-open:rotate-45 group-open:bg-navy-900 group-open:border-navy-900 group-open:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed whitespace-pre-line">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Need Data Matrix code printing?"
    text="Contact us — we'll quote your order and advise on requirements."
    primaryHref="/en/kontakt/"
    primaryLabel="Send inquiry"
    secondaryHref="tel:+48604286423"
    secondaryLabel="Call: 604 286 423"
  />

</Base>
