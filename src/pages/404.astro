---
import Base from '../layouts/Base.astro';
import DataMatrix from '../components/DataMatrix.astro';
---

<Base
  title="404 — nie znaleziono strony | Drukarnia WIPP Białystok"
  description="Strona, której szukasz, nie istnieje. Wróć na stronę główną Drukarni WIPP Białystok."
>
  <section class="relative overflow-hidden bg-navy-950 text-white min-h-[70vh] flex items-center pt-16">
    <div class="absolute inset-0 bg-grid-dark" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[50rem] h-[30rem] bg-accent-500/15 rounded-full blur-3xl" aria-hidden="true"></div>
    <DataMatrix seed={44} class="absolute -right-12 -bottom-16 w-72 text-white/[0.05] rotate-12" />

    <div class="relative max-w-3xl mx-auto px-4 py-20 text-center">
      <p class="font-mono text-7xl md:text-8xl font-bold text-accent-400 mb-6">404</p>
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight mb-4">Ta etykieta nie została wydrukowana</h1>
      <p class="text-navy-200 mb-3 max-w-xl mx-auto">
        Strona, której szukasz, nie istnieje lub została przeniesiona.
      </p>
      <p class="font-mono text-xs text-navy-400 mb-10">
        Page not found · Страница не найдена
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn btn-light">Strona główna</a>
        <a href="/kontakt/" class="btn btn-outline-light">Kontakt</a>
      </div>
    </div>
  </section>
</Base>
