---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';

const faqItems = [
  {
    question: "Czym jest kod Data Matrix?",
    answer: "Data Matrix to dwuwymiarowy kod kreskowy, który może zawierać dużo informacji na małej powierzchni. Każda jednostka produktu otrzymuje unikalny kod zawierający m.in. numer GTIN, numer seryjny i klucz weryfikacyjny. Kody te są wykorzystywane w systemach oznakowania produktów na wielu rynkach."
  },
  {
    question: "Jakie produkty wymagają kodów Data Matrix?",
    answer: "Kody Data Matrix są wymagane w wielu branżach, m.in.: wyroby tytoniowe, obuwie, perfumy, opony, leki, nabiał, woda, piwo, odzież, wyroby cukiernicze, herbata, kawa i elektronika. Lista kategorii stale rośnie."
  },
  {
    question: "Dlaczego druk kodów Data Matrix jest trudny?",
    answer: "Każda sztuka produktu musi mieć swój unikalny kod Data Matrix — nie ma dwóch takich samych etykiet. Np. opakowanie zbiorcze 30 batonów wymaga 30 indywidualnych naklejek + 1 kod agregacji na kartonie. To druk danych zmiennych (variable data printing), który wymaga specjalistycznego sprzętu i doświadczenia."
  },
  {
    question: "Co zawiera kod Data Matrix?",
    answer: "Kod Data Matrix zawiera co najmniej cztery grupy informacji: GTIN (Global Trade Item Number), numer seryjny produktu, klucz weryfikacyjny oraz kod kryptograficzny. Razem tworzą one unikalny identyfikator, który pozwala śledzić każdą jednostkę produktu w łańcuchu dostaw."
  },
  {
    question: "Jak wygląda proces zamówienia oznaczeń w drukarni WIPP?",
    answer: "Proces jest prosty:\n1) Przesyłasz nam plik z unikalnymi kodami Data Matrix.\n2) Przygotowujemy projekt etykiet zgodny z wymaganiami systemu.\n3) Drukujemy naklejki z indywidualnymi kodami w wymaganej kolejności.\n4) Dostarczamy gotowe etykiety — każda z unikalnym kodem, gotowa do naklejenia na produkt."
  },
  {
    question: "Ile kosztuje druk kodów Data Matrix?",
    answer: "Cena zależy od nakładu, rozmiaru etykiet i materiału. Skontaktuj się z nami telefonicznie (604 286 423) lub mailowo — przygotujemy indywidualną wycenę w ciągu 24-48 godzin."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const challenges = [
  {
    title: "Każda etykieta jest unikalna",
    html: `W odróżnieniu od zwykłego druku, gdzie wszystkie naklejki są identyczne,
      <strong>każda pojedyncza sztuka produktu</strong> musi mieć swój własny, niepowtarzalny kod Data Matrix.
      Przykład: opakowanie zbiorcze 30 batonów wymaga wydrukowania 30 różnych naklejek + 1 kodu agregacji na kartonie.`
  },
  {
    title: "Druk danych zmiennych (Variable Data Printing)",
    html: `Każda etykieta zawiera inne dane — wymaga to specjalistycznego oprogramowania i maszyn drukarskich
      przystosowanych do druku danych zmiennych z wysoką prędkością i precyzją. Błąd w jednym kodzie oznacza
      odrzucenie całej partii.`
  },
  {
    title: "Agregacja i hierarchia kodów",
    html: `System wymaga nie tylko kodów na poziomie jednostkowym, ale również <strong>kodów agregacji</strong>
      na opakowaniach zbiorczych i paletach. Cała hierarchia musi być spójna i zarejestrowana w systemie.`
  }
];

const offers = [
  { title: "Druk dostarczonych kodów", desc: "Klient dostarcza nam pliki z unikalnymi kodami Data Matrix, a my drukujemy je na naklejkach w wymaganej kolejności i układzie." },
  { title: "Kody agregacji", desc: "Etykiety na opakowania zbiorcze i palety z kodami łączącymi jednostki w hierarchię." },
  { title: "Wysoki nakład, szybka realizacja", desc: "Obsługujemy duże wolumeny druku danych zmiennych z krótkim czasem realizacji." },
  { title: "Doświadczenie od 1997 roku", desc: "Ponad 25 lat w branży poligraficznej. Wiemy, jak drukować precyzyjnie i niezawodnie." }
];
---

<Base
  title="Druk kodów Data Matrix — unikalne etykiety | Drukarnia WIPP Białystok"
  description="Druk indywidualnych kodów Data Matrix na naklejkach. Specjalizujemy się w druku unikalnych etykiet dla każdej sztuki produktu. Drukarnia WIPP Białystok."
  schema={faqSchema}
>

  <PageHero
    eyebrow="Nasza specjalizacja"
    title="Druk kodów Data Matrix"
    highlight="Unikalne etykiety dla każdego produktu"
    subtitle="Specjalizujemy się w druku unikalnych kodów Data Matrix na naklejkach — każda sztuka produktu otrzymuje indywidualny kod."
  />

  <!-- Why it's hard -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-8">Dlaczego druk kodów Data Matrix wymaga specjalisty?</h2>
      <div class="space-y-5">
        {challenges.map((c, i) => (
          <div class="bg-white rounded-2xl border border-navy-100 p-6 md:p-8 shadow-sm">
            <div class="flex items-start gap-5">
              <span class="shrink-0 font-mono text-sm font-bold text-accent-600 bg-accent-500/10 rounded-lg px-3 py-2">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-extrabold tracking-tight text-navy-900 mb-2">{c.title}</h3>
                <p class="text-gray-600 leading-relaxed" set:html={c.html} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we deliver -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-10">Co oferujemy?</h2>
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-8">
        {offers.map(o => (
          <div class="flex gap-4">
            <div class="shrink-0 w-11 h-11 bg-navy-900 text-white rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <h3 class="font-extrabold tracking-tight text-navy-900 mb-1.5">{o.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{o.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="eyebrow text-accent-600 mb-3">FAQ</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Najczęstsze pytania o kody Data Matrix</h2>
      </div>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="group bg-white rounded-2xl border border-navy-100 shadow-sm open:shadow-md transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-bold text-navy-950 hover:text-navy-700 transition-colors">
              {item.question}
              <span class="shrink-0 w-8 h-8 rounded-full border border-navy-200 flex items-center justify-center text-navy-500 transition-all duration-200 group-open:rotate-45 group-open:bg-navy-900 group-open:border-navy-900 group-open:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed whitespace-pre-line">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Potrzebujesz druku kodów Data Matrix?"
    text="Skontaktuj się z nami — wycenimy Twoje zamówienie i doradzimy w kwestii wymagań."
    primaryHref="/kontakt/"
    primaryLabel="Wyślij zapytanie"
    secondaryHref="tel:+48604286423"
    secondaryLabel="Zadzwoń: 604 286 423"
  />

</Base>
