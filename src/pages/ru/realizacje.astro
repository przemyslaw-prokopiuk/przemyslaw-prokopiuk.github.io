---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DataMatrix from '../../components/DataMatrix.astro';

const items = [
  { title: 'Этикетки Data Matrix', desc: 'Индивидуальные коды Data Matrix на самоклеящихся наклейках' },
  { title: 'Продуктовые наклейки', desc: 'Этикетки на упаковки со штрих-кодом и графикой' },
  { title: 'Визитки', desc: 'Элегантные визитки на мелованной бумаге' },
  { title: 'Рекламные листовки', desc: 'Рекламные материалы в форматах A5 и DL' },
  { title: 'Футболки с принтом', desc: 'Персонализированные футболки для компаний и команд' },
  { title: 'Плакаты и баннеры', desc: 'Широкоформатная печать плакатов и рекламных материалов' },
];
---

<Base
  lang="ru"
  title="Портфолио — наши работы | Типография WIPP Белосток"
  description="Примеры наших работ: наклейки, этикетки, коды Data Matrix, визитки, листовки, плакаты и футболки с принтом. Типография WIPP Белосток."
>

  <PageHero
    eyebrow="Портфолио"
    title="Наши работы"
    subtitle="Примеры наших работ — от кодов Data Matrix до рекламных материалов."
  />

  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-5xl mx-auto px-4">

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        {items.map((item, i) => (
          <div class="relative bg-white rounded-2xl border border-navy-100 p-7 shadow-sm hover:shadow-lg transition-shadow overflow-hidden">
            <DataMatrix seed={i + 31} class="absolute -right-6 -bottom-8 w-28 text-navy-900/[0.04] rotate-12" />
            <div class="relative">
              <div class="w-11 h-11 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="font-extrabold tracking-tight text-navy-900">{item.title}</h3>
              <p class="text-sm text-gray-600 mt-1.5 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <p class="text-gray-500 mb-6">Хотите увидеть больше примеров? Свяжитесь с нами — мы с удовольствием покажем портфолио.</p>
        <a href="/ru/kontakt/" class="btn btn-primary">Связаться с нами</a>
      </div>

    </div>
  </section>

</Base>
