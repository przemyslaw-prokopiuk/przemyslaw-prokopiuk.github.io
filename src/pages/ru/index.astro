---
import Base from '../../layouts/Base.astro';
import DataMatrix from '../../components/DataMatrix.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://wipp-drukarnia.pl/#business",
  "name": "Wipp Piotr Prokopiuk — Типография",
  "image": "https://wipp-drukarnia.pl/logo.png",
  "description": "Цифровая типография в Белостоке. Специализация: печать кодов Data Matrix, наклейки и самоклеящиеся этикетки.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "ul. Kombatantów 7A",
    "addressLocality": "Białystok",
    "postalCode": "15-110",
    "addressCountry": "PL"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 53.1500,
    "longitude": 23.1595
  },
  "telephone": "+48604286423",
  "email": "wippdrukarnia@gmail.com",
  "url": "https://wipp-drukarnia.pl",
  "hasMap": "https://maps.google.com/?q=Wipp+Piotr+Prokopiuk+Kombatant%C3%B3w+7A+Bia%C5%82ystok",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "07:00",
    "closes": "15:00"
  },
  "priceRange": "$$",
  "areaServed": [
    { "@type": "City", "name": "Białystok" },
    { "@type": "Country", "name": "Polska" }
  ]
};
---

<Base
  lang="ru"
  title="Типография этикеток WIPP Белосток — коды Data Matrix, наклейки, цифровая печать"
  description="Цифровая типография в Белостоке. Специализируемся на печати кодов Data Matrix, наклеек и самоклеящихся этикеток. Быстрое выполнение, конкурентные цены."
  schema={schema}
>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-950 text-white">
    <div class="absolute inset-0 bg-grid-dark" aria-hidden="true"></div>
    <div class="absolute -top-40 -right-20 w-[45rem] h-[45rem] bg-accent-500/15 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-60 -left-40 w-[35rem] h-[35rem] bg-navy-700/40 rounded-full blur-3xl" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-4 pt-32 pb-16 md:pt-40 md:pb-24 grid lg:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
      <div class="text-center lg:text-left">
        <p class="eyebrow text-accent-400 mb-5">Цифровая типография · Белосток</p>
        <h1 class="text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6">
          Специалисты по печати<br />
          <span class="bg-gradient-to-r from-accent-300 to-accent-500 bg-clip-text text-transparent">кодов Data Matrix</span>
        </h1>
        <p class="text-lg md:text-xl text-navy-200 max-w-2xl mx-auto lg:mx-0 mb-9 leading-relaxed">
          Печатаем предоставленные коды Data Matrix на наклейках.
          Каждый продукт — индивидуальная этикетка, в правильном порядке. Быстро, точно, в срок.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/ru/kontakt/" class="btn btn-light text-lg">Заказать расчёт</a>
          <a href="/ru/data-matrix/" class="btn btn-outline-light text-lg">Узнать больше</a>
        </div>
        <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 justify-center lg:justify-start text-sm text-navy-200">
          <span><span class="font-mono font-bold text-accent-400">25+</span> лет опыта</span>
          <span><span class="font-mono font-bold text-accent-400">10000+</span> выполненных заказов</span>
          <span><span class="font-mono font-bold text-accent-400">24–48ч</span> экспресс-выполнение</span>
        </div>
      </div>

      <!-- Printed label artwork -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="absolute top-8 right-0 w-72 h-80 rotate-6 rounded-2xl bg-white/10 border border-white/10"></div>
        <div class="anim-label relative w-72 mx-auto -rotate-3 rounded-2xl bg-white p-7 shadow-2xl shadow-black/40">
          <div class="relative">
            <div class="anim-code"><DataMatrix text="https://wipp-drukarnia.pl/ru/" class="w-full text-navy-950" /></div>
            <div class="anim-head" aria-hidden="true"></div>
          </div>
          <div class="mt-5 font-mono text-[11px] leading-relaxed text-navy-900">
            (01) 05901234123457<br />
            (21) 4KT9XQ2M8LDW<br />
            (91) EE07<br />
            (92) dGVzdEtleTJQcm9k
          </div>
          <div class="mt-4 pt-3 border-t border-dashed border-navy-200 flex justify-between items-center font-mono text-[10px] text-navy-400">
            <span>WIPP · VDP</span><span>0001/10000</span>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-3 rounded-xl bg-accent-500 text-navy-950 font-mono text-xs font-bold px-4 py-2 shadow-lg rotate-3">
          100% уникальных кодов
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-accent-600 mb-3">Что мы делаем</p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Наши услуги</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <a href="/ru/data-matrix/" class="group bg-white rounded-2xl border border-navy-100 p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-navy-900/10 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5 group-hover:bg-accent-500 transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
          </div>
          <h3 class="text-xl font-extrabold tracking-tight mb-2">Коды Data Matrix</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-5">
            Профессиональная печать предоставленных кодов Data Matrix на наклейках — в требуемом порядке, в срок.
          </p>
          <span class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 group-hover:text-accent-600 transition-colors">
            Подробнее
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>

        <a href="/ru/kody-kreskowe/" class="group bg-white rounded-2xl border border-navy-100 p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-navy-900/10 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5 group-hover:bg-accent-500 transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6v12M8 6v12M12 6v8M12 17.99V18M16 6v8M16 17.99V18M20 6v12" /></svg>
          </div>
          <h3 class="text-xl font-extrabold tracking-tight mb-2">Штрих-коды и QR</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-5">
            Коды EAN, QR, GS1-128 и этикетки с переменными данными — серийная нумерация и уникальные коды из файла PDF.
          </p>
          <span class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 group-hover:text-accent-600 transition-colors">
            Подробнее
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>

        <a href="/ru/uslugi/" class="group bg-white rounded-2xl border border-navy-100 p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-navy-900/10 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5 group-hover:bg-accent-500 transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" /></svg>
          </div>
          <h3 class="text-xl font-extrabold tracking-tight mb-2">Наклейки и этикетки</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-5">
            Самоклеящиеся этикетки, продуктовые наклейки, штрих-коды. Печать на бумаге, плёнке и специальных материалах.
          </p>
          <span class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 group-hover:text-accent-600 transition-colors">
            Подробнее
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>

        <a href="/ru/uslugi/" class="group bg-white rounded-2xl border border-navy-100 p-6 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-navy-900/10 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-xl bg-navy-900 text-white flex items-center justify-center mb-5 group-hover:bg-accent-500 transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
          </div>
          <h3 class="text-xl font-extrabold tracking-tight mb-2">Цифровая печать</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-5">
            Визитки, листовки, плакаты, буклеты, фирменные бланки. Даже малые тиражи. Экспресс 24-48ч.
          </p>
          <span class="inline-flex items-center gap-1.5 text-sm font-bold text-navy-700 group-hover:text-accent-600 transition-colors">
            Подробнее
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>

      </div>

      <p class="mt-12 text-center font-mono text-[11px] font-bold uppercase tracking-[0.25em] text-gray-400">
        Печатаем для FMCG: <span class="text-navy-500">Молочные продукты · Напитки · Сладости · Консервы · Кофе и чай · Косметика</span>
      </p>
    </div>
  </section>

  <!-- Why us -->
  <section class="relative overflow-hidden bg-navy-950 text-white py-16 md:py-24">
    <div class="absolute inset-0 bg-grid-dark" aria-hidden="true"></div>
    <div class="absolute -top-32 left-1/3 w-[35rem] h-[25rem] bg-accent-500/10 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-accent-400 mb-3">Доверие</p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Почему WIPP?</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/10 rounded-2xl overflow-hidden border border-white/10">
        <div class="bg-navy-950/90 p-8 text-center">
          <div class="font-mono text-4xl md:text-5xl font-bold text-accent-400 mb-3">25+</div>
          <p class="text-navy-200 text-sm">Лет на рынке полиграфии</p>
        </div>
        <div class="bg-navy-950/90 p-8 text-center">
          <div class="font-mono text-4xl md:text-5xl font-bold text-accent-400 mb-3">10000+</div>
          <p class="text-navy-200 text-sm">Выполненных заказов</p>
        </div>
        <div class="bg-navy-950/90 p-8 text-center">
          <div class="font-mono text-4xl md:text-5xl font-bold text-accent-400 mb-3">24–48ч</div>
          <p class="text-navy-200 text-sm">Экспресс-выполнение</p>
        </div>
        <div class="bg-navy-950/90 p-8 text-center">
          <div class="font-mono text-4xl md:text-5xl font-bold text-accent-400 mb-3">100%</div>
          <p class="text-navy-200 text-sm">Уникальных кодов — каждая этикетка другая</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Нужна печать кодов Data Matrix?"
    text="Свяжитесь с нами — подготовим расчёт и выполним заказ быстро и в срок."
    primaryHref="/ru/kontakt/"
    primaryLabel="Отправить запрос"
    secondaryHref="tel:+48604286423"
    secondaryLabel="Позвонить: 604 286 423"
  />

</Base>
