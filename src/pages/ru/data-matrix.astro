---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const faqItems = [
  {
    question: "Что такое код Data Matrix?",
    answer: "Data Matrix — это двумерный штрих-код, способный хранить большой объём информации на малой площади. Каждая единица продукции получает уникальный код, содержащий номер GTIN, серийный номер и ключ проверки. Такие коды применяются в системах маркировки продукции на многих рынках."
  },
  {
    question: "Какие товары требуют кодов Data Matrix?",
    answer: "Коды Data Matrix требуются во многих отраслях, включая: табачные изделия, обувь, парфюмерию, шины, лекарственные препараты, молочную продукцию, воду, пиво, одежду, кондитерские изделия, чай, кофе и электронику. Перечень категорий постоянно расширяется."
  },
  {
    question: "Почему печать кодов Data Matrix — это сложно?",
    answer: "Каждая отдельная единица продукции должна иметь собственный уникальный код Data Matrix. Например, групповая упаковка из 30 батончиков требует 30 индивидуальных наклеек + 1 код агрегации на коробке. Это печать переменных данных, которая требует специализированного оборудования и опыта."
  },
  {
    question: "Что содержит код Data Matrix?",
    answer: "Код Data Matrix содержит как минимум четыре группы информации: GTIN (Global Trade Item Number), серийный номер продукта, ключ проверки и криптографический код. Вместе они образуют уникальный идентификатор, позволяющий отслеживать каждую единицу продукции в цепочке поставок."
  },
  {
    question: "Как выглядит процесс заказа в типографии WIPP?",
    answer: "Процесс прост:\n1) Вы отправляете нам файл с уникальными кодами Data Matrix.\n2) Мы подготавливаем макет этикеток в соответствии с требованиями системы.\n3) Печатаем наклейки с индивидуальными кодами в требуемом порядке.\n4) Доставляем готовые этикетки — каждая с уникальным кодом, готовая к нанесению на продукт."
  },
  {
    question: "Печатаете ли вы этикетки для системы «Честный знак»?",
    answer: "Да. Печатаем предоставленные коды маркировки Data Matrix, в том числе коды системы «Честный знак» для экспортёров на рынки ЕАЭС (Россия, Беларусь, Казахстан). Вы выгружаете файл с кодами маркировки из личного кабинета системы, а мы печатаем этикетки в требуемом порядке — как единичные, так и агрегационные."
  },
  {
    question: "Сколько стоит печать кодов Data Matrix?",
    answer: "Цена зависит от тиража, размера этикеток и материала. Свяжитесь с нами по телефону (604 286 423) или по электронной почте — мы подготовим индивидуальный расчёт в течение 24-48 часов."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const challenges = [
  {
    title: "Каждая этикетка уникальна",
    html: `В отличие от обычной печати, где все наклейки одинаковы,
      <strong>каждая отдельная единица продукции</strong> должна иметь собственный уникальный код Data Matrix.
      Пример: групповая упаковка из 30 батончиков требует 30 разных наклеек + 1 код агрегации на коробке.`
  },
  {
    title: "Печать переменных данных (Variable Data Printing)",
    html: `Каждая этикетка содержит разные данные — это требует специализированного программного обеспечения
      и печатного оборудования, приспособленного для печати переменных данных с высокой скоростью и точностью.
      Ошибка в одном коде означает отбраковку всей партии.`
  },
  {
    title: "Агрегация и иерархия кодов",
    html: `Система требует не только кодов на уровне единицы, но и <strong>кодов агрегации</strong>
      на групповых упаковках и палетах. Вся иерархия должна быть согласованной и зарегистрированной.`
  }
];

const offers = [
  { title: "Печать предоставленных кодов", desc: "Клиент предоставляет нам файлы с уникальными кодами Data Matrix, а мы печатаем их на наклейках в требуемом порядке и расположении." },
  { title: "Коды агрегации", desc: "Этикетки для групповых упаковок и палет с кодами, связывающими единицы в иерархию." },
  { title: "Большие тиражи, быстрое выполнение", desc: "Обслуживаем большие объёмы печати переменных данных с коротким сроком выполнения." },
  { title: "Опыт с 1997 года", desc: "Более 25 лет в полиграфической отрасли. Мы знаем, как печатать точно и надёжно." }
];
---

<Base
  lang="ru"
  title="Печать кодов Data Matrix — уникальные этикетки | Типография WIPP Белосток"
  description="Печать индивидуальных кодов Data Matrix на наклейках. Специализируемся на печати уникальных этикеток для каждой единицы продукции. Типография WIPP Белосток."
  schema={faqSchema}
>

  <PageHero
    eyebrow="Наша специализация"
    title="Печать кодов Data Matrix"
    highlight="Уникальные этикетки для каждого продукта"
    subtitle="Специализируемся на печати уникальных кодов Data Matrix на наклейках — каждая единица продукции получает индивидуальный код."
  />

  <!-- Why it's hard -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-8">Почему печать кодов Data Matrix требует специалиста?</h2>
      <div class="space-y-5">
        {challenges.map((c, i) => (
          <div class="bg-white rounded-2xl border border-navy-100 p-6 md:p-8 shadow-sm">
            <div class="flex items-start gap-5">
              <span class="shrink-0 font-mono text-sm font-bold text-accent-600 bg-accent-500/10 rounded-lg px-3 py-2">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-extrabold tracking-tight text-navy-900 mb-2">{c.title}</h3>
                <p class="text-gray-600 leading-relaxed" set:html={c.html} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we deliver -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-10">Что мы предлагаем?</h2>
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-8">
        {offers.map(o => (
          <div class="flex gap-4">
            <div class="shrink-0 w-11 h-11 bg-navy-900 text-white rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <h3 class="font-extrabold tracking-tight text-navy-900 mb-1.5">{o.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{o.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-navy-50/60">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="eyebrow text-accent-600 mb-3">FAQ</p>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">Часто задаваемые вопросы о кодах Data Matrix</h2>
      </div>
      <div class="space-y-4">
        {faqItems.map(item => (
          <details class="group bg-white rounded-2xl border border-navy-100 shadow-sm open:shadow-md transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 font-bold text-navy-950 hover:text-navy-700 transition-colors">
              {item.question}
              <span class="shrink-0 w-8 h-8 rounded-full border border-navy-200 flex items-center justify-center text-navy-500 transition-all duration-200 group-open:rotate-45 group-open:bg-navy-900 group-open:border-navy-900 group-open:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed whitespace-pre-line">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    title="Нужна печать кодов Data Matrix?"
    text="Свяжитесь с нами — рассчитаем стоимость вашего заказа и проконсультируем."
    primaryHref="/ru/kontakt/"
    primaryLabel="Отправить запрос"
    secondaryHref="tel:+48604286423"
    secondaryLabel="Позвонить: 604 286 423"
  />

</Base>
